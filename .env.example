# =============================================================================
# TraceLens environment configuration
#
# Copy to .env and fill in the values marked REQUIRED. Never commit .env.
# Variables are grouped by the service that reads them:
#   [web]  Next.js dashboard (apps/web)
#   [api]  FastAPI backend and ARQ worker (apps/api)
#   [both] read by both services
#   [compose] only used by docker-compose.yml
# Nothing secret may use the NEXT_PUBLIC_ prefix: those values ship to browsers.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [both] development | test | production. Development enables the local dev
# mailbox (/dev/mailbox) when SMTP is not configured. Production refuses to
# start sign-up email flows without SMTP.
TRACELENS_ENV=development

# --- Database and cache ------------------------------------------------------
# [compose] Credentials for the bundled Postgres container. REQUIRED for compose.
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=change-me-generate-a-random-password
POSTGRES_DB=tracelens

# [compose] Host ports. Change them if they collide with other local services.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# [both] REQUIRED. Postgres connection string used by processes on your host.
# The API converts the scheme to SQLAlchemy's psycopg driver automatically.
# docker-compose overrides this with the internal "postgres" hostname.
DATABASE_URL=postgresql://tracelens:change-me-generate-a-random-password@localhost:5432/tracelens

# [api] REQUIRED. Redis for rate limiting and the ARQ background queue.
# Traces are always stored durably in Postgres, never only in Redis.
REDIS_URL=redis://localhost:6379/0

# --- Authentication (Better Auth) -------------------------------------------
# [web] REQUIRED. At least 32 random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=
# [web] REQUIRED. Public base URL of the dashboard (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# [web] Optional. Extra comma-separated origins allowed to call /api/auth.
BETTER_AUTH_TRUSTED_ORIGINS=

# [web] Optional but needed for "Sign in with Google". Create an OAuth client
# (type: Web application) in Google Cloud Console > APIs & Services >
# Credentials. Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [web] Optional SMTP settings for verification, password reset, and invitation
# emails. Without them, development stores emails in the dev mailbox table.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Service-to-service authentication --------------------------------------
# [both] REQUIRED. Shared HMAC secret. The web server signs 60-second JWTs
# (iss=tracelens-web, aud=tracelens-api) that identify the dashboard user; the
# API verifies them and still checks organization membership in Postgres.
# Generate with: openssl rand -base64 48
INTERNAL_JWT_SECRET=

# [web] Internal URL the Next.js server uses to reach FastAPI.
TRACELENS_API_URL=http://localhost:8000

# [web] Public, non-secret URLs rendered in snippets and links.
NEXT_PUBLIC_TRACELENS_INGEST_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_DOCS_URL=

# [api] Comma-separated browser origins allowed by CORS. The dashboard calls
# the API from its server, so this only matters for direct browser clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Ingestion and privacy --------------------------------------------------
# [api] Per-API-key request budget per minute.
INGEST_RATE_LIMIT_PER_MINUTE=600
# [api] Maximum accepted request body in bytes (default 5 MiB).
MAX_REQUEST_BYTES=5242880
# [api] Whether new projects capture raw span inputs/outputs. Secrets are
# always redacted; this controls whether payloads are stored at all.
DEFAULT_CAPTURE_PAYLOADS=false
# [api] Default trace retention for new projects, in days.
DEFAULT_RETENTION_DAYS=30
# [api] Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# [api] Optional path to a pricing JSON file that replaces the bundled
# app/pricing/pricing.json. See docs/pricing.md.
PRICING_FILE=

# --- AI providers (optional) ------------------------------------------------
# [api] Fernet key used to encrypt per-project provider credentials at rest.
# Required only if you want to save provider keys from the dashboard.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# [api] Operator-level fallback credentials for the AI failure investigator,
# LLM-judge evaluator, and model-backed evaluation runs. Leave empty to rely on
# deterministic diagnostics only. On a shared/hosted instance prefer
# per-project keys so tenants do not spend the operator's credits.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# [api] Which provider and model the fallback credentials use, e.g.
# LLM_PROVIDER=openai and LLM_MODEL=<a model your account can access>.
LLM_PROVIDER=
LLM_MODEL=
